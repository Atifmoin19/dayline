# Copy to .env and fill in real values. Never commit .env (already gitignored).

# --- Database ---
# Falls back to a local SQLite file if unset (dev-only convenience).
DATABASE_URL=postgresql://postgres:CHANGE_ME@taskboard_db:5432/taskboard_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=taskboard_db

# --- Email notifications (Mandrill SMTP) --- unset => silent no-op
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Slack notifications --- unset => silent no-op
SLACK_WEBHOOK_URL=

# --- Web-push (VAPID) --- unset => silent no-op. Mint separate keys per environment,
# never reuse dev keys in prod.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=

# --- API path prefix ---
# Path the reverse proxy mounts this API under (FastAPI root_path). Defaults to /api.
# Set to an empty value when hitting uvicorn directly without a proxy.
API_ROOT_PATH=/api

# --- CORS (comma-separated production frontend origins; localhost is always allowed) ---
FRONTEND_ORIGIN=

# --- Frontend URL (used to build the "Open in Dayline" link in notification emails) ---
# Defaults to http://localhost:5173/ if unset.
FRONTEND_APP_URL=

# --- Sentry error tracking --- unset SENTRY_DSN => silent no-op
SENTRY_DSN=
# development | staging | production (tags events so they can be filtered in Sentry). Defaults
# to "development" if unset.
ENVIRONMENT=

# --- Timeline timezone / business hours (defaults: Asia/Kolkata, 19, 12) ---
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_END_HOUR=19
MAX_OPEN_SESSION_HOURS=12

# --- Celery (background jobs: overdue sweep, replacing the old in-process asyncio loop) ---
# Broker/result backend is Redis, reusing the same REDIS_HOST/REDIS_PORT the session store
# (redis_client.py) already connects to (docker-compose sets these; unset here => Celery
# falls back to redis_client's own default of localhost:6379). Celery uses a separate DB
# index (REDIS_DB_CELERY) so its keys never collide with the session store's (REDIS_DB,
# default 0). Unset REDIS_DB_CELERY => defaults to 1.
REDIS_DB_CELERY=1
# Full overrides, only needed if Celery should use a DIFFERENT Redis instance than the
# session store. Unset => derived from REDIS_HOST/REDIS_PORT/REDIS_DB_CELERY above.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# How often Celery Beat fires the overdue sweep, in seconds. Unset => 60 (same cadence as
# the old asyncio loop's `await asyncio.sleep(60)`).
OVERDUE_SWEEP_INTERVAL_SECONDS=60

# --- AI Insight (GET /insights) --- unset GEMINI_API_KEY (and _2/_3) => endpoint returns a
# 200 "available": false response instead of calling Gemini. Keys are tried in order
# (GEMINI_API_KEY, then _2, then _3) — a bad/rate-limited/invalid key just falls through to
# the next one. GEMINI_MODEL unset => defaults to "gemini-2.0-flash" (gemini_util.py).
# Generated insights are cached per-caller in Redis for 5 minutes (main.py's
# INSIGHTS_CACHE_TTL_SECONDS) so a busy dashboard doesn't call Gemini on every page load.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=

# --- SSO / OIDC (scale-gaps-plan.md Phase 3) --- unset OIDC_ISSUER => /auth/sso/status
# reports {"enabled": false} and the frontend hides the SSO button entirely; local
# emp_id/password login keeps working either way. Works with any OIDC-compliant IdP —
# Okta, Azure AD / Entra ID, Google Workspace — since they all expose the same
# /.well-known/openid-configuration discovery doc; no per-provider code branching needed.
# SSO never auto-creates accounts: the id_token's email claim must match an existing
# users.emp_email row (provisioned via seed_demo.py / admin CSV, same as today).
#
# OIDC_ISSUER examples:
#   Okta:       https://your-org.okta.com
#   Azure AD:   https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google:     https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must exactly match the redirect URI registered with the IdP, and point at this backend's
# own /auth/sso/callback (not the frontend).
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
# Label shown on the frontend's "Sign in with ..." button.
OIDC_PROVIDER_LABEL=Single Sign-On

# --- pgAdmin (dev only, not used in prod compose) ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# --- "Try the demo" sandboxes (POST /demo, see demo.py) --- off unless "true".
# Each visitor gets an isolated copy of the fictional Quillbrook Labs org that expires after
# DEMO_TTL_HOURS. Demo users get in-app notifications only (no email/Slack/push) and no
# admin, bulk-upload or password features.
DEMO_MODE_ENABLED=false
DEMO_TTL_HOURS=24
DEMO_MAX_PER_IP_PER_HOUR=5
DEMO_MAX_LIVE_WORKSPACES=100
# Salt for the stored (hashed) client IP used by the per-IP limit. Use a random value.
DEMO_IP_SALT=CHANGE_ME
