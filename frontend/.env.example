# Copy to .env.local (gitignored) and adjust.
# Label used to namespace the persisted Redux store (e.g. DEV, STAGING, PROD).
VITE_APP_ENV=DEV
# Backend base URL. Behind a reverse proxy this is usually https://<your-host>/api;
# for local dev, point straight at uvicorn.
VITE_APP_BASE_URL=http://localhost:8052
# IANA timezone used for timeline/business-hours math (defaults to Asia/Kolkata if unset).
VITE_BUSINESS_TZ=UTC
# Show "Try the demo" on the login page. Needs DEMO_MODE_ENABLED=true on the backend too.
VITE_DEMO_ENABLED=false
# Landing-page "Source on GitHub" link (defaults to the author's GitHub profile).
VITE_GITHUB_URL=https://github.com/Atifmoin19/dayline
# Shared contact API that receives "Request a workspace" submissions (POST {url}/contact).
VITE_CONTACT_API_URL=https://api.fullstackcity.in/portfolio
